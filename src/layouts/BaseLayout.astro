---
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
};

const { title = 'My Blog', description = '개인 블로그' } = Astro.props as Props;
const base = import.meta.env.BASE_URL;
const homeHref = base.endsWith('/') ? base : `${base}/`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-shell site-header__inner">
        <a class="site-logo" href={homeHref} aria-label="Ted Song 홈">Ted Song</a>
        <div class="site-header__actions">
          <nav class="site-nav" aria-label="주요 메뉴">
            <a href={`${homeHref}#posts`} aria-current={title === 'My Blog' ? 'page' : undefined}>글</a>
            <a href={`${homeHref}#about`}>소개</a>
          </nav>
          <button class="menu-button" type="button" disabled aria-expanded="false" aria-label="메뉴 열기">
            <span aria-hidden="true">☰</span>
          </button>
        </div>
      </div>
    </header>

    <main class="site-shell site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-shell site-footer__inner">
        <span>© {year} My Blog</span>
        <nav class="footer-links" aria-label="외부 링크">
          <a href="https://github.com/kitae0522">GitHub</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
