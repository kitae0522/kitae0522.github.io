---
import '../styles/global.css';

type Props = {
  title?: string;
  description?: string;
  pageKind?: 'home' | 'post' | 'about' | 'search';
};

const { title = 'My Blog', description = '개인 블로그', pageKind = 'post' } = Astro.props as Props;
const base = import.meta.env.BASE_URL;
const homeHref = base.endsWith('/') ? base : `${base}/`;
const aboutHref = `${homeHref}about/`;
const searchHref = `${homeHref}search/`;
const rssHref = `${homeHref}rss.xml`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@fontsource/jetbrains-mono@5.2.8/latin-400.css"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@fontsource/jetbrains-mono@5.2.8/latin-400-italic.css"
    />
    <link rel="alternate" type="application/rss+xml" title="Ted Song RSS" href={rssHref} />
    <title>{title}</title>
  </head>
  <body class:list={{ 'home-view': pageKind === 'home' }}>
    <header class="site-header">
      <div class="site-shell site-header__inner">
        <a class="site-logo" href={homeHref} aria-label="Ted Song 홈">Ted Song</a>
        <div class="site-header__actions">
          <nav class="site-nav" aria-label="주요 메뉴">
            <a href={`${homeHref}#posts`} aria-current={pageKind === 'home' ? 'page' : undefined}>글</a>
            <a href={searchHref} aria-current={pageKind === 'search' ? 'page' : undefined}>검색</a>
            <a href={aboutHref} aria-current={pageKind === 'about' ? 'page' : undefined}>소개</a>
          </nav>
        </div>
      </div>
    </header>

    <main class="site-shell site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-shell site-footer__inner">
        <span>© {year} Ted Song</span>
        <nav class="footer-links" aria-label="외부 링크">
          <a href={rssHref}>RSS</a>
          <a href="https://github.com/kitae0522">GitHub</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
