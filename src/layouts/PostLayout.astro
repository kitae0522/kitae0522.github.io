---
import BaseLayout from './BaseLayout.astro';

type Frontmatter = {
  title: string;
  date: Date;
  category: 'daily' | 'dev' | 'startup' | 'retrospective';
  tags: string[];
  published: boolean;
  description?: string;
};

type AdjacentPost = {
  id: string;
  title: string;
};

type Props = {
  frontmatter: Frontmatter;
  previous?: AdjacentPost;
  next?: AdjacentPost;
  readingTime?: number;
};

const { frontmatter, previous, next, readingTime = 1 } = Astro.props as Props;
const { title, date, category, description = '' } = frontmatter;
const base = import.meta.env.BASE_URL;
const baseWithoutTrailingSlash = base.replace(/\/$/, '');
const homeHref = base.endsWith('/') ? base : `${base}/`;
const postsBase = baseWithoutTrailingSlash === '' ? '/posts' : `${baseWithoutTrailingSlash}/posts`;
const formatDate = (value: Date) => value.toISOString().slice(0, 10).replaceAll('-', '.');
---

<BaseLayout title={title} description={description}>
  <article class="post-page">
    <a class="back-link" href={`${homeHref}#posts`}>← 글 목록</a>

    <header class="post-header">
      <p class="post-category"><span class="category-marker" aria-hidden="true"></span>{category}</p>
      <h1 class="post-title">{title}</h1>
      {description && <p class="post-summary">{description}</p>}
      <div class="post-byline">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        <span class="post-byline__separator" aria-hidden="true">·</span>
        <span>읽는 시간 약 {readingTime}분</span>
      </div>
    </header>

    <div class="post-divider" aria-hidden="true"></div>

    <div class="post-content">
      <slot />
    </div>

    <nav class="post-pagination" aria-label="글 탐색">
      {previous ? (
        <a class="post-pagination__link" href={`${postsBase}/${previous.id}`}>
          <span class="post-pagination__label">이전 글</span>
          <strong class="post-pagination__title">{previous.title}</strong>
        </a>
      ) : <span class="post-pagination__empty" aria-hidden="true"></span>}
      {next ? (
        <a class="post-pagination__link post-pagination__link--next" href={`${postsBase}/${next.id}`}>
          <span class="post-pagination__label">다음 글</span>
          <strong class="post-pagination__title">{next.title}</strong>
        </a>
      ) : <span class="post-pagination__empty" aria-hidden="true"></span>}
    </nav>
  </article>
</BaseLayout>
