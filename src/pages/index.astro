---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = await getCollection('posts', (post) => post.data.published);
const sortedPosts = [...allPosts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const base = import.meta.env.BASE_URL;
const baseWithoutTrailingSlash = base.replace(/\/$/, '');
const homeHref = base.endsWith('/') ? base : `${base}/`;
const postsBase = baseWithoutTrailingSlash === '' ? '/posts' : `${baseWithoutTrailingSlash}/posts`;
const formatDate = (date: Date) => date.toISOString().slice(0, 10).replaceAll('-', '.');
---

<BaseLayout title="My Blog" description="Personal notes.">
  <div class="home-page">
    <section class="home-intro" id="about" aria-labelledby="home-title">
      <h1 class="home-title" id="home-title">Personal notes.</h1>
      <p class="home-description">기록하고, 만들고, 배우는 일을 적습니다.</p>
      <nav class="home-links" aria-label="관련 링크">
        <a class="text-link" href="https://github.com/kitae0522">GitHub</a>
        <a class="text-link" href="https://kitae0522.github.io">Portfolio</a>
        <a class="text-link" id="rss" href={`${homeHref}#rss`}>RSS</a>
      </nav>
      <span class="visually-hidden" id="search">검색 기능은 준비 중입니다.</span>
    </section>

    <section class="home-posts" id="posts" aria-label="글 목록">
      {sortedPosts.length > 0 ? (
        <ol class="post-list">
          {sortedPosts.map((post, postIndex) => (
            <li class="home-post">
              <a class="home-post__link" href={`${postsBase}/${post.id}`}>
                <div class="home-post__row">
                  {postIndex === 0 && <span class="post-link__marker" aria-hidden="true"></span>}
                  <div class="home-post__body">
                    <h2 class="home-post__title">{post.data.title}</h2>
                    {post.data.description && <p class="home-post__summary">{post.data.description}</p>}
                    <time class="home-post__date" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                  </div>
                </div>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty-posts">아직 공개된 글이 없습니다.</p>
      )}
    </section>
  </div>
</BaseLayout>
