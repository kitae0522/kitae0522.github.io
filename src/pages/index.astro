---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = await getCollection('posts', (post) => post.data.published);
const sortedPosts = [...allPosts].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const base = import.meta.env.BASE_URL;
const baseWithoutTrailingSlash = base.replace(/\/$/, '');
const postsBase = baseWithoutTrailingSlash === '' ? '/posts' : `${baseWithoutTrailingSlash}/posts`;
const formatDate = (date: Date) => date.toISOString().slice(0, 10).replaceAll('-', '.');
const getReadingTime = (body: string | undefined) => Math.max(1, Math.ceil((body ?? '').trim().split(/\s+/).filter(Boolean).length / 200));
---

<BaseLayout title="My Blog" description="Personal notes.">
  <div class="home-page">
    <section class="home-intro" id="about" aria-labelledby="home-title">
      <h1 class="home-title" id="home-title">Personal notes.</h1>
      <p class="home-description">기록하고, 만들고, 배우는 일을 적습니다.</p>
    </section>

    <section class="home-posts" id="posts" aria-label="글 목록">
      {sortedPosts.length > 0 ? (
        <ol class="post-list">
          {sortedPosts.map((post) => (
            <li>
              <a class="home-card" href={`${postsBase}/${post.id}`}>
                <div class="taxonomy-chips" aria-label="글 분류">
                  <span class="taxonomy-chip taxonomy-chip--category">{post.data.category}</span>
                  <span class="home-card__reading">{getReadingTime(post.body)}분 읽기</span>
                </div>
                <h2 class="home-card__title">{post.data.title}</h2>
                {post.data.description && <p class="home-card__summary">{post.data.description}</p>}
                <div class="home-card__metadata">
                  {post.data.tags.map((tag, index) => (
                    <>
                      {index > 0 && <span aria-hidden="true">·</span>}
                      <span>#{tag}</span>
                    </>
                  ))}
                  {post.data.tags.length > 0 && <span aria-hidden="true">·</span>}
                  <time class="home-card__date" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
                </div>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty-posts">아직 공개된 글이 없습니다.</p>
      )}
    </section>
  </div>
</BaseLayout>
